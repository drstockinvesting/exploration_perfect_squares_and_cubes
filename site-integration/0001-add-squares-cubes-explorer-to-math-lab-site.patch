+/* ============================================================================
+   FONTS  —  the Dr. Cole's Math Lab brand faces
+   ========================================================================== */
+/* FONTS:START */
+/* Nunito + Space Mono, SIL Open Font License, inlined as base64 so the page has
+   zero external requests and renders correctly opened straight from disk.
+   Source files and licence text: assets/fonts/. Regenerate with
+   node tools/apply-site-chrome.js — do not hand-edit. */
+@font-face{
+  font-family:'Nunito';
+  font-weight:400 900;
+  font-style:normal;
+  font-display:swap;
+  src:url(data:font/woff2;base64,) format('woff2');
+}
+@font-face{
+  font-family:'Space Mono';
+  font-weight:400;
+  font-style:normal;
+  font-display:swap;
+  src:url(data:font/woff2;base64,) format('woff2');
+}
+@font-face{
+  font-family:'Space Mono';
+  font-weight:700;
+  font-style:normal;
+  font-display:swap;
+  src:url(data:font/woff2;base64,) format('woff2');
+}
+/* FONTS:END */
+
+/* ============================================================================
+   THEME TOKENS  —  Dr. Cole's Math Lab
+   Dark only, deliberately. The Math Lab palette is a dark one; a light variant
+   of it would be a different design rather than the same one turned up, so
+   there is no prefers-color-scheme branch and no data-theme hook here.
+   Surface and ink values are carried verbatim from the site's
+   tools/site.config.js `tokens`, where they are contrast-measured to WCAG AA.
+   ========================================================================== */
+:root {
+  color-scheme: dark;
+
+  --bg:            #050610;   /* brand --bg  */
+  --panel:         #0c0b1d;   /* brand --sf  */
+  --panel-2:       #141328;   /* brand --sf2 */
+  --ink:           #ffffff;   /* brand --pre */
+  --ink-soft:      #eef2ff;   /* brand --tx  */
+  --ink-faint:     #7a83a8;   /* brand --mu  */
+  --line:          #141328;
+  --line-strong:   #26243f;
+
+  /* Mode accents: brand --tc and --or. --*-fill tints the flat figures — the
+     unit row, the n x n square, the exploded layer plates — where one pass of
+     alpha over --bg is all that ever composites. */
+  --sq:            #00d4ff;   /* squares accent */
+  --sq-fill:       rgba(0, 212, 255, .30);
+  --sq-fill-2:     rgba(0, 212, 255, .15);
+  --cu:            #ff9500;   /* cubes accent  */
+  --cu-fill:       rgba(255, 149, 0, .30);
+  --cu-fill-2:     rgba(255, 149, 0, .15);
+
+  /* The assembled cube is the one place a tint will not do, and it needs its
+     own token. Its shell is up to 488 unit cubes of six faces each, so alpha
+     compounds through the stack until the figure is a solid block with no unit
+     edges showing. These are the same two hues composited over --bg once and
+     then frozen opaque, so the cube stays a lattice at every n. */
+  --sq-face:       #0a4a5e;
+  --cu-face:       #5c380a;
+
+  --accent:        var(--sq);
+  --fill:          var(--sq-fill);
+  --fill-2:        var(--sq-fill-2);
+  --face:          var(--sq-face);
+  --glow:          #ffcc00;   /* gnomon / new-units highlight — brand --oc */
+  --on-accent:     #04202b;   /* ink on a saturated accent, as the site uses */
+
+  --shadow:        0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.45);
+  --radius:        14px;
+
+  /* The two brand faces. Space Mono carries every number on the screen: the
+     side length, the totals, the notation and the layer tags all change as the
+     slider moves, and a proportional face makes them jitter as digits swap. */
+  --sans:  'Nunito', 'Avenir Next', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
+  --mono:  'Space Mono', 'SF Mono', Consolas, monospace;
+}
+
+/* Cubes mode repoints the accent tokens; every figure reads from these. */
+body[data-mode="cubes"] {
+  --accent: var(--cu);
+  --fill:   var(--cu-fill);
+  --fill-2: var(--cu-fill-2);
+  --face:   var(--cu-face);
+}
+
+/* ============================================================================
+   BASE
+   ========================================================================== */
+* { box-sizing: border-box; }
+html, body { height: 100%; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font: 16px/1.45 var(--sans);
+  -webkit-font-smoothing: antialiased;
+  overflow-x: hidden;
+}
+.app {
+  max-width: 1500px;
+  margin: 0 auto;
+  padding: 18px 22px 28px;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  min-height: 100%;
+}
+/* Figures carry display:grid, which would otherwise beat the UA rule for the
+   hidden attribute and leak the inactive figure onto the screen. */
+[hidden] { display: none !important; }
+.sr-only {
+  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
+  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
+}
+
+/* ============================================================================
+   HEADER + CONTROLS
+   ========================================================================== */
+header.bar {
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  flex-wrap: wrap;
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 12px 16px;
+  box-shadow: var(--shadow);
+}
+.title {
+  font-size: 19px;
+  font-weight: 800;
+  letter-spacing: -.01em;
+  color: var(--ink);
+  margin-right: auto;
+  display: flex;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 4px 10px;
+}
+/* Wordmark, split the way the site splits it: a white "Dr. Cole's" against the
+   cyan "Math Lab". It sits on its own line above the app name at every width,
+   so the app never reads as being called "Dr. Cole's Math Lab Squares...".
+   Pinned to --sq rather than --accent: the mode accent is a reading cue for the
+   figures, and the brand mark should not change colour when the shape does. */
+.title .wordmark {
+  flex-basis: 100%;
+  font-size: 12px;
+  font-weight: 900;
+  letter-spacing: .02em;
+  color: var(--sq);
+}
+.title .wordmark b { color: var(--ink); font-weight: 900; }
+.title .level {
+  font-size: 12px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: .08em;
+  color: var(--ink-faint);
+}
+.group {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.group > .glabel {
+  font-size: 11px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: .07em;
+  color: var(--ink-faint);
+}
+.seg {
+  display: inline-flex;
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 3px;
+  gap: 3px;
+}
+button {
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+.seg button {
+  appearance: none;
+  border: 0;
+  background: transparent;
+  border-radius: 7px;
+  padding: 7px 14px;
+  font-size: 14px;
+  font-weight: 650;
+  color: var(--ink-soft);
+  transition: background .15s ease, color .15s ease;
+  white-space: nowrap;
+}
+.seg button:hover { color: var(--ink); }
+.seg button[aria-pressed="true"] {
+  background: var(--accent);
+  color: var(--on-accent);
+}
+.btn {
+  appearance: none;
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  padding: 8px 14px;
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--ink-soft);
+  transition: background .15s ease, color .15s ease, border-color .15s ease;
+}
+.btn:hover { color: var(--ink); border-color: var(--line-strong); }
+.btn[aria-pressed="true"] {
+  background: var(--accent);
+  border-color: var(--accent);
+  color: var(--on-accent);
+}
+.btn[hidden], .group[hidden] { display: none; }
+button:focus-visible, input:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+}
+
+/* ============================================================================
+   STAGE GRID  —  side length | operation | figure + count
+   ========================================================================== */
+.stage {
+  flex: 1;
+  display: grid;
+  grid-template-columns: 1fr minmax(180px, 260px) 1fr;
+  gap: 16px;
+  align-items: stretch;
+}
+.panel {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+  padding: 16px 18px 20px;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+.panel.mid {
+  background: transparent;
+  border: 0;
+  box-shadow: none;
+  justify-content: center;
+  align-items: center;
+  padding: 0;
+}
+.roleline {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 2px;
+  min-height: 18px;
+}
+.role {
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--ink-faint);
+  transition: color .2s ease;
+}
+.role.is-input { color: var(--accent); }
+.panel h2 {
+  font-size: 15px;
+  font-weight: 700;
+  margin: 0 0 12px;
+  color: var(--ink-soft);
+}
+
+/* ---- left: slider + unit row ---------------------------------------------- */
+.readout {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  margin-bottom: 6px;
+}
+.readout .big {
+  font-family: var(--mono);
+  font-size: 54px;
+  font-weight: 700;
+  line-height: 1;
+  /* Space Mono's "1" carries a full-width base serif, so at display size the
+     digits read as touching without a little air between them. */
+  letter-spacing: .02em;
+  color: var(--accent);
+  font-variant-numeric: tabular-nums;
+}
+.readout .unitword {
+  font-size: 14px;
+  color: var(--ink-soft);
+  font-weight: 600;
+}
+input[type=range] {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 100%;
+  height: 30px;
+  background: transparent;
+  margin: 2px 0 0;
+  cursor: pointer;
+}
+input[type=range]::-webkit-slider-runnable-track {
+  height: 10px;
+  border-radius: 999px;
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+}
+input[type=range]::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  width: 28px; height: 28px;
+  margin-top: -10px;
+  border-radius: 50%;
+  background: var(--accent);
+  border: 3px solid var(--panel);
+  box-shadow: 0 2px 6px rgba(0,0,0,.5);
+}
+input[type=range]::-moz-range-track {
+  height: 10px;
+  border-radius: 999px;
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+}
+input[type=range]::-moz-range-thumb {
+  width: 22px; height: 22px;
+  border-radius: 50%;
+  background: var(--accent);
+  border: 3px solid var(--panel);
+  box-shadow: 0 2px 6px rgba(0,0,0,.5);
+}
+.ticks {
+  font-family: var(--mono);
+  display: flex;
+  justify-content: space-between;
+  font-size: 11px;
+  color: var(--ink-faint);
+  font-variant-numeric: tabular-nums;
+  margin-top: -2px;
+}
+.rowwrap {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  min-height: 150px;
+  padding: 14px 0 4px;
+  perspective: 1400px;
+}
+#unitRow {
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  gap: 3px;
+  flex-wrap: wrap;
+  max-width: 100%;
+  transform-style: preserve-3d;
+}
+.rowcaption {
+  margin-top: 14px;
+  font-size: 13px;
+  color: var(--ink-soft);
+  text-align: center;
+}
+.rowcaption b { color: var(--ink); }
+
+/* ---- unit square (shared by row + big square + cube layers) ---------------- */
+.usq {
+  width: var(--u, 26px);
+  height: var(--u, 26px);
+  background: var(--fill);
+  border: 1px solid var(--accent);
+  border-radius: 2px;
+}
+.usq.thin { border-width: 1px; }
+
+/* ---- centre: arrow + notation --------------------------------------------- */
+.opblock {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  width: 100%;
+}
+.oplabel {
+  font-size: 13px;
+  font-weight: 700;
+  letter-spacing: .06em;
+  text-transform: uppercase;
+  color: var(--accent);
+  text-align: center;
+  min-height: 18px;
+}
+#arrow { width: 100%; max-width: 240px; height: 56px; overflow: visible; }
+#arrow .shaft, #arrow .head {
+  fill: none;
+  stroke: var(--accent);
+  stroke-width: 9;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+#arrow .head { fill: var(--accent); stroke-width: 0; }
+#arrowGroup { transition: transform .35s cubic-bezier(.4,0,.2,1); transform-origin: 120px 28px; }
+body[data-dir="left"] #arrowGroup { transform: scaleX(-1); }
+
+.notation {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+  padding: 14px 22px;
+  min-width: 150px;
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  min-height: 84px;
+}
+.math {
+  font-family: var(--mono);
+  font-weight: 700;
+  font-size: 38px;
+  line-height: 1;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+  display: inline-flex;
+  align-items: flex-start;
+  white-space: nowrap;
+}
+.math sup {
+  font-size: .52em;
+  line-height: 1;
+  vertical-align: super;
+  margin-left: .04em;
+  color: var(--accent);
+  font-weight: 600;
+}
+/* Radical: an SVG check-mark whose up-stroke ends exactly at the top edge, so
+   it meets the radicand's CSS overline with no seam. Index tucked top-left. */
+.radical {
+  position: relative;
+  display: inline-flex;
+  align-items: flex-start;
+  padding-left: .34em;
+}
+.radical .idx {
+  position: absolute;
+  left: 0;
+  top: -.02em;
+  font-size: .40em;
+  font-weight: 700;
+  line-height: 1;
+  color: var(--accent);
+}
+.radical .sign {
+  width: .46em;
+  height: .95em;
+  flex: none;
+  overflow: visible;
+}
+.radical .sign path {
+  fill: none;
+  stroke: var(--accent);
+  stroke-width: 3;
+  stroke-linecap: square;
+  stroke-linejoin: miter;
+  vector-effect: non-scaling-stroke;
+}
+.radical .rad {
+  border-top: 3px solid var(--accent);
+  line-height: .74;
+  padding: .1em .2em 0 .1em;
+}
+.eqline {
+  margin-top: 10px;
+  font-size: 14px;
+  color: var(--ink-soft);
+  text-align: center;
+  min-height: 20px;
+}
+.eqline b { color: var(--ink); font-family: var(--mono); font-weight: 700; }
+
+/* ---- right: figure + counter ---------------------------------------------- */
+.figwrap {
+  flex: 1;
+  display: grid;
+  place-items: center;
+  min-height: 300px;
+  padding: 8px 0 4px;
+  position: relative;
+}
+#squareFig {
+  display: grid;
+  gap: 2px;
+}
+#squareFig .usq { animation: none; }
+#squareFig .usq.isnew { animation: pop .45s cubic-bezier(.34,1.56,.64,1) backwards; }
+@keyframes pop {
+  0%   { transform: scale(.2); background: var(--glow); opacity: 0; }
+  60%  { background: var(--glow); }
+  100% { transform: scale(1); opacity: 1; }
+}
+
+/* ---- 3D cube stage --------------------------------------------------------- */
+#cubeFig {
+  width: 100%;
+  height: 100%;
+  min-height: 300px;
+  display: grid;
+  place-items: center;
+  perspective: 1600px;
+  touch-action: none;
+  cursor: grab;
+}
+#cubeFig.dragging { cursor: grabbing; }
+#cubeStage {
+  transform-style: preserve-3d;
+  transform: rotateX(var(--rx, -24deg)) rotateY(var(--ry, -32deg)) scale(var(--fit, 1));
+  transition: transform .45s cubic-bezier(.4,0,.2,1);
+  position: relative;
+  width: 0; height: 0;
+}
+#cubeStage.nosnap { transition: none; }
+.cubeBuild {
+  position: absolute;
+  left: 0; top: 0;
+  transform-style: preserve-3d;
+  transition: opacity .3s ease;
+}
+.cubeBuild[hidden] { display: none; }
+
+.ucube { position: absolute; transform-style: preserve-3d; }
+.ucube > i {
+  position: absolute;
+  display: block;
+  background: var(--face);
+  border: 1px solid var(--accent);
+  left: 0; top: 0;
+}
+/* Per-orientation tint so edges read without lighting maths. */
+.ucube > i.f  { filter: brightness(1.06); }
+.ucube > i.bk { filter: brightness(.80); }
+.ucube > i.r  { filter: brightness(.90); }
+.ucube > i.l  { filter: brightness(.90); }
+.ucube > i.t  { filter: brightness(1.16); }
+.ucube > i.bt { filter: brightness(.72); }
+
+.layer {
+  position: absolute;
+  transform-style: preserve-3d;
+  transition: transform .5s cubic-bezier(.4,0,.2,1);
+}
+.layerPlate {
+  position: absolute;
+  display: grid;
+  gap: 1px;
+  background: var(--line);
+  padding: 1px;
+}
+.layerTag {
+  position: absolute;
+  font-family: var(--mono);
+  font-size: 11px;
+  font-weight: 700;
+  color: var(--ink-soft);
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 1px 6px;
+  white-space: nowrap;
+  transform: translateZ(1px);
+}
+
+/* ---- counter --------------------------------------------------------------- */
+.counter {
+  border-top: 1px dashed var(--line);
+  padding-top: 12px;
+  margin-top: 8px;
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+.counter .total {
+  font-family: var(--mono);
+  font-size: 54px;
+  font-weight: 700;
+  line-height: 1;
+  /* Space Mono's "1" carries a full-width base serif, so at display size the
+     digits read as touching without a little air between them. */
+  letter-spacing: .02em;
+  color: var(--accent);
+  font-variant-numeric: tabular-nums;
+}
+.counter .total.tick { animation: tick .3s ease; }
+@keyframes tick { 0% { transform: translateY(-6px); opacity: .35; } 100% { transform: none; opacity: 1; } }
+.counter .meta { display: flex; flex-direction: column; gap: 2px; }
+.counter .meta .eq {
+  font-family: var(--mono);
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+}
+.counter .meta .sub {
+  font-size: 13px;
+  color: var(--ink-soft);
+  font-variant-numeric: tabular-nums;
+}
+.pulse { animation: pulse .55s ease; }
+@keyframes pulse {
+  0%, 100% { transform: none; }
+  35%      { transform: scale(1.06); }
+}
+
+.footnote {
+  text-align: center;
+  font-size: 12px;
+  color: var(--ink-faint);
+}
+.footnote kbd {
+  font-family: var(--mono);
+  font-size: .9em;
+  background: var(--panel-2);
+  border: 1px solid var(--line-strong);
+  border-bottom-width: 2px;
+  border-radius: 5px;
+  padding: 1px 6px;
+  color: var(--ink);
+}
+
+/* ============================================================================
+   RESPONSIVE  —  mobile is deliberately a working fallback, not a finished
+   design. Columns stack and the arrow turns to point down / up.
+   ========================================================================== */
+@media (max-width: 900px) {
+  .stage { grid-template-columns: 1fr; }
+  .panel.mid { padding: 6px 0; }
+  /* A square box so the rotated arrow always has room, and one rotation for
+     both directions — the group's own flip already turns "left" into "up". */
+  #arrow { width: 110px; height: 110px; max-width: none; transform: rotate(90deg); }
+  .figwrap, #cubeFig { min-height: 240px; }
+  .readout .big, .counter .total { font-size: 46px; }
+  .math { font-size: 34px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: .001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: .001ms !important;
+  }
+}
