+
+<script>
+"use strict";
+/* ============================================================================
+ * 1. CONFIG — everything mode-specific lives here so nothing is hardcoded
+ *    downstream. Future levels read the same table.
+ * ==========================================================================*/
+const CONFIG = {
+  squares: {
+    dim: 2, min: 1, max: 20, def: 5,
+    exponent: "2",
+    radicalIndex: "",          // √ has no printed index
+    figureName: "square",
+    unitName: "unit square",
+    unitNamePlural: "unit squares",
+    opForward: "Squaring",
+    opBackward: "Square rooting",
+    btnForward: "→ Square it",
+    btnBackward: "← Square root"
+  },
+  cubes: {
+    dim: 3, min: 1, max: 10, def: 3,
+    exponent: "3",
+    radicalIndex: "3",
+    figureName: "cube",
+    unitName: "unit cube",
+    unitNamePlural: "unit cubes",
+    opForward: "Cubing",
+    opBackward: "Cube rooting",
+    btnForward: "→ Cube it",
+    btnBackward: "← Cube root"
+  }
+};
+
+/* The radical sign. The path ends at (24, 1.5) — the top right corner — which
+   is where the radicand's CSS overline begins, so the two read as one stroke. */
+const RADICAL_SVG =
+  '<svg class="sign" viewBox="0 0 24 44" preserveAspectRatio="none" aria-hidden="true">' +
+  '<path d="M0.5 26 L6 26 L12.5 42 L21 1.5 L24 1.5"/></svg>';
+
+/* The seed viewing angle for the cube: a clear three-quarter isometric read. */
+const SEED_RX = -24, SEED_RY = -32;
+
+/* ============================================================================
+ * 2. STATE — one plain object plus a diffing setState, so a rotation drag
+ *    never rebuilds several hundred cube nodes.
+ * ==========================================================================*/
+const state = {
+  level: 1,
+  mode: "squares",
+  n: CONFIG.squares.def,
+  direction: "right",     // "right" = square/cube, "left" = root
+  exploded: false,
+  rx: SEED_RX,
+  ry: SEED_RY
+};
+let prevN = state.n;      // used for the gnomon highlight
+
+const $ = (id) => document.getElementById(id);
+const el = {
+  body: document.body,
+  sideValue: $("sideValue"), sideWord: $("sideWord"), sideSlider: $("sideSlider"),
+  tickMin: $("tickMin"), tickMax: $("tickMax"),
+  unitRow: $("unitRow"), rowCaption: $("rowCaption"),
+  leftH: $("leftH"), rightH: $("rightH"), leftRole: $("leftRole"), rightRole: $("rightRole"),
+  opLabel: $("opLabel"), notation: $("notation"), eqLine: $("eqLine"),
+  figwrap: $("figWrap"),
+  squareFig: $("squareFig"), cubeFig: $("cubeFig"), cubeStage: $("cubeStage"),
+  cubeSolid: $("cubeSolid"), cubeLayers: $("cubeLayers"),
+  totalValue: $("totalValue"), totalEq: $("totalEq"), totalSub: $("totalSub"),
+  liveSummary: $("liveSummary"),
+  modeSquares: $("modeSquares"), modeCubes: $("modeCubes"),
+  dirRight: $("dirRight"), dirLeft: $("dirLeft"),
+  cubeTools: $("cubeTools"), explodeBtn: $("explodeBtn"), resetViewBtn: $("resetViewBtn"),
+  levelTag: $("levelTag")
+};
+
+const cfg = () => CONFIG[state.mode];
+const total = (s = state) => Math.pow(s.n, CONFIG[s.mode].dim);
+
+function setState(patch) {
+  const before = Object.assign({}, state);
+  Object.assign(state, patch);
+
+  const modeChanged = before.mode !== state.mode;
+  const nChanged    = before.n !== state.n;
+  const dirChanged  = before.direction !== state.direction;
+  const expChanged  = before.exploded !== state.exploded;
+  const rotChanged  = before.rx !== state.rx || before.ry !== state.ry;
+
+  if (rotChanged) applyRotation();
+  if (!(modeChanged || nChanged || dirChanged || expChanged)) return;
+
+  if (modeChanged) { prevN = state.n; renderChrome(); }
+  if (modeChanged || nChanged) {
+    renderSlider();
+    renderRow();
+    renderFigure(nChanged && !modeChanged ? before.n : null);
+  }
+  if (modeChanged || expChanged) renderExplode();
+  renderNotation();
+  renderCounter(nChanged || modeChanged);
+  renderRoles();
+  if (nChanged) prevN = state.n;
+}
+
+/* ============================================================================
+ * 3. BUILDERS — pure-ish DOM factories. Later levels reuse these untouched;
+ *    only the surrounding controls change.
+ * ==========================================================================*/
+
+const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
+
+/** Space actually available inside the figure panel — measured, not assumed,
+ *  so the figures fit whatever window (or phone) they are handed. */
+/* Measuring the panel forces layout, so the box is cached and invalidated
+   whenever something that can change it happens (render, resize). This keeps
+   drag-rotation, which re-fits on every pointer move, off the layout path. */
+let boxCache = null;
+function invalidateBox() { boxCache = null; }
+function figBox() {
+  if (!boxCache) {
+    boxCache = {
+      w: Math.max(140, (el.figwrap.clientWidth || 340) - 8),
+      h: Math.max(140, (el.figwrap.clientHeight || 340) - 8)
+    };
+  }
+  return boxCache;
+}
+function figBudget() {
+  const b = figBox();
+  return Math.min(b.w, b.h);
+}
+function rowBudget() {
+  const w = (el.unitRow.parentElement && el.unitRow.parentElement.clientWidth) || 320;
+  return Math.max(140, w - 8);
+}
+
+/** Unit size for the figure on the right. Small side lengths are allowed to
+ *  grow large so the figure fills the panel on a projector. The 1.55 for cubes
+ *  leaves room for the isometric projection, wider than the n x u footprint. */
+function figUnitSize(n, mode) {
+  return mode === "cubes"
+    ? clamp(Math.floor(figBudget() / (n * 1.55)), 10, 60)
+    : clamp(Math.floor((figBudget() - (n - 1) * 2) / n), 6, 72);
+}
+/** Unit size for the linear row on the left. Capped at the figure's own unit
+ *  size, so a row unit never looks bigger than the units it builds. */
+function rowUnitSize(n, mode) {
+  let u = Math.floor((rowBudget() - (n - 1) * 3) / n);
+  if (mode === "cubes") u = Math.floor(u / 1.4);   // isometric offset margins
+  return clamp(Math.min(u, figUnitSize(n, mode)), mode === "cubes" ? 10 : 6, 72);
+}
+function squareUnitSize(n) { return figUnitSize(n, "squares"); }
+function cubeUnitSize(n)   { return figUnitSize(n, "cubes"); }
+
+/** buildRow: the n units laid in a line — flat squares, or little 3D cubes. */
+function buildRow(n, mode) {
+  const frag = document.createDocumentFragment();
+  const u = rowUnitSize(n, mode);
+  for (let i = 0; i < n; i++) {
+    if (mode === "cubes") {
+      frag.appendChild(makeUnitCube(u, { x: 0, y: 0, z: 0, inline: true }));
+    } else {
+      const d = document.createElement("div");
+      d.className = "usq";
+      d.style.setProperty("--u", u + "px");
+      frag.appendChild(d);
+    }
+  }
+  return { frag, u };
+}
+
+/** buildSquare: an n x n grid; units added since prev are flagged .isnew
+ *  so the L-shaped gnomon (2n-1 units) animates in. */
+function buildSquare(n, previous) {
+  const frag = document.createDocumentFragment();
+  const u = squareUnitSize(n);
+  const showGnomon = previous !== null && previous !== undefined && n > previous;
+  for (let r = 0; r < n; r++) {
+    for (let c = 0; c < n; c++) {
+      const d = document.createElement("div");
+      d.className = "usq";
+      d.style.setProperty("--u", u + "px");
+      if (showGnomon && (r >= previous || c >= previous)) {
+        d.classList.add("isnew");
+        d.style.animationDelay = (Math.max(r, c) - previous) * 12 + "ms";
+      }
+      frag.appendChild(d);
+    }
+  }
+  return { frag, u };
+}
+
+/** One unit cube: six faces on a preserve-3d wrapper. */
+function makeUnitCube(u, pos) {
+  const c = document.createElement("div");
+  c.className = "ucube";
+  c.style.width = u + "px";
+  c.style.height = u + "px";
+  if (pos.inline) {
+    // Row usage: participates in normal flow, keeps its own 3D tilt.
+    c.style.position = "relative";
+    c.style.transform = "rotateX(-20deg) rotateY(-28deg)";
+    c.style.marginRight = Math.round(u * 0.35) + "px";
+    c.style.marginTop = Math.round(u * 0.30) + "px";
+  } else {
+    c.style.transform =
+      "translate3d(" + (pos.x * u) + "px," + (pos.y * u) + "px," + (pos.z * u) + "px)";
+  }
+  const faces = [
+    ["f",  "translateZ(" + (u / 2) + "px)"],
+    ["bk", "rotateY(180deg) translateZ(" + (u / 2) + "px)"],
+    ["r",  "rotateY(90deg) translateZ(" + (u / 2) + "px)"],
+    ["l",  "rotateY(-90deg) translateZ(" + (u / 2) + "px)"],
+    ["t",  "rotateX(90deg) translateZ(" + (u / 2) + "px)"],
+    ["bt", "rotateX(-90deg) translateZ(" + (u / 2) + "px)"]
+  ];
+  for (const [cls, tf] of faces) {
+    const f = document.createElement("i");
+    f.className = cls;
+    f.style.width = u + "px";
+    f.style.height = u + "px";
+    f.style.transform = tf;
+    c.appendChild(f);
+  }
+  return c;
+}
+
+/** buildCubeShell: only cubes with a coordinate on the outside are built.
+ *  Visually identical from any angle; 488 cubes instead of 1000 at n = 10. */
+function buildCubeShell(n) {
+  const frag = document.createDocumentFragment();
+  const u = cubeUnitSize(n);
+  // A unit cube's box starts at its translate point, so the solid is centred on
+  // the stage origin at -n/2, not -(n-1)/2.
+  const off = -n / 2;
+  let built = 0;
+  for (let x = 0; x < n; x++) {
+    for (let y = 0; y < n; y++) {
+      for (let z = 0; z < n; z++) {
+        const onShell =
+          x === 0 || x === n - 1 || y === 0 || y === n - 1 || z === 0 || z === n - 1;
+        if (!onShell) continue;
+        frag.appendChild(makeUnitCube(u, { x: x + off, y: y + off, z: z + off }));
+        built++;
+      }
+    }
+  }
+  return { frag, u, built };
+}
+
+/** buildCubeLayers: the n cross-sections, each a flat n x n plate of unit
+ *  squares — one node per unit, which is what the exploded view is about. */
+function buildCubeLayers(n) {
+  const frag = document.createDocumentFragment();
+  const u = cubeUnitSize(n);
+  const plate = n * u + (n - 1) + 2;     // grid gaps + padding
+  const off = -(n - 1) / 2;
+  for (let z = 0; z < n; z++) {
+    const layer = document.createElement("div");
+    layer.className = "layer";
+    layer.dataset.index = String(z);
+    layer.style.transitionDelay = (z * 22) + "ms";
+
+    const p = document.createElement("div");
+    p.className = "layerPlate";
+    p.style.gridTemplateColumns = "repeat(" + n + ", " + u + "px)";
+    p.style.width = plate + "px";
+    p.style.height = plate + "px";
+    p.style.left = (-plate / 2) + "px";
+    p.style.top = (-plate / 2) + "px";
+    for (let i = 0; i < n * n; i++) {
+      const d = document.createElement("div");
+      d.className = "usq thin";
+      d.style.setProperty("--u", u + "px");
+      p.appendChild(d);
+    }
+    layer.appendChild(p);
+
+    const tag = document.createElement("span");
+    tag.className = "layerTag";
+    tag.textContent = n + " × " + n + " = " + (n * n);
+    tag.style.left = (plate / 2 + 10) + "px";
+    tag.style.top = "-9px";
+    layer.appendChild(tag);
+
+    layer.dataset.baseZ = String((z + off) * u);
+    frag.appendChild(layer);
+  }
+  return { frag, u, plate };
+}
+
+/* ============================================================================
+ * 4. RENDERERS
+ * ==========================================================================*/
+function renderChrome() {
+  const c = cfg();
+  el.body.dataset.mode = state.mode;
+  el.modeSquares.setAttribute("aria-pressed", String(state.mode === "squares"));
+  el.modeCubes.setAttribute("aria-pressed", String(state.mode === "cubes"));
+  el.dirRight.textContent = c.btnForward;
+  el.dirLeft.textContent = c.btnBackward;
+  el.rightH.textContent = "The " + c.figureName;
+  el.sideWord.textContent = "units along one side";
+  el.totalSub.textContent = c.unitNamePlural + " in all";
+  el.cubeTools.hidden = state.mode !== "cubes";
+  el.squareFig.hidden = state.mode !== "squares";
+  el.cubeFig.hidden = state.mode !== "cubes";
+}
+
+function renderSlider() {
+  const c = cfg();
+  el.sideSlider.min = String(c.min);
+  el.sideSlider.max = String(c.max);
+  el.sideSlider.value = String(state.n);
+  el.tickMin.textContent = String(c.min);
+  el.tickMax.textContent = String(c.max);
+  el.sideValue.textContent = String(state.n);
+}
+
+function renderRow() {
+  invalidateBox();
+  const { frag } = buildRow(state.n, state.mode);
+  el.unitRow.replaceChildren(frag);
+  el.rowCaption.innerHTML =
+    "<b>" + state.n + "</b> " + (state.n === 1 ? cfg().unitName : cfg().unitNamePlural) +
+    " in a line — this is the side length.";
+}
+
+function renderFigure(previousN) {
+  invalidateBox();
+  if (state.mode === "squares") {
+    const { frag, u } = buildSquare(state.n, previousN);
+    el.squareFig.style.gridTemplateColumns = "repeat(" + state.n + ", " + u + "px)";
+    el.squareFig.replaceChildren(frag);
+  } else {
+    const shell = buildCubeShell(state.n);
+    el.cubeSolid.replaceChildren(shell.frag);
+    const layers = buildCubeLayers(state.n);
+    el.cubeLayers.replaceChildren(layers.frag);
+    positionLayers();
+  }
+}
+
+/** Gap between exploded layers: generous at small n, capped at large n so the
+ *  stack still fits without scaling the unit squares into invisibility. */
+function explodeSpread(n, u) {
+  return Math.max(u * 1.15, Math.min(u * 2.3, 520 / Math.max(n - 1, 1)));
+}
+
+/** Layers sit flush when assembled, fanned along z when exploded. The fanned
+ *  stack is deeper than the panel at large n, so the stage is scaled to fit. */
+function positionLayers() {
+  const n = state.n;
+  const u = cubeUnitSize(n);
+  const spread = state.exploded ? explodeSpread(n, u) : u;
+  const off = -(n - 1) / 2;
+  const layers = el.cubeLayers.children;
+  for (let z = 0; z < layers.length; z++) {
+    const L = layers[z];
+    L.style.transform = "translateZ(" + ((z + off) * spread) + "px)";
+    // display, not opacity: a hidden tag must not occupy space either.
+    const showTag = state.exploded && (n <= 5 || z === layers.length - 1);
+    L.querySelector(".layerTag").style.display = showTag ? "" : "none";
+  }
+  updateFit();
+}
+
+/** Scale the whole stage so the current view fits the panel — for the fanned
+ *  stack and for the assembled cube, whose isometric projection is wider than
+ *  its own footprint. Cheap enough to re-run while dragging. */
+function updateFit() {
+  if (state.mode !== "cubes") return;
+  const n = state.n;
+  const u = cubeUnitSize(n);
+  let fit;
+  if (state.exploded) {
+    const spread = explodeSpread(n, u);
+    const plate = n * u + (n - 1) + 2;
+    // Layer tags hang off the right of each plate and scale with them.
+    fit = fitScale(plate, (n - 1) * spread, 100);
+  } else {
+    fit = fitScale(n * u, n * u, 0);
+  }
+  el.cubeStage.style.setProperty("--fit", String(fit));
+}
+
+/** How much the fanned stack has to shrink to sit inside the figure panel.
+ *  A plate of side P centred on the origin, stacked across a depth D, then
+ *  rotated by (rx, ry), projects to a box of these half-extents — times the
+ *  perspective magnification of the nearest plate. */
+function fitScale(P, D, tagW) {
+  const rad = (d) => d * Math.PI / 180;
+  const cx = Math.abs(Math.cos(rad(state.rx))), sx = Math.abs(Math.sin(rad(state.rx)));
+  const cy = Math.abs(Math.cos(rad(state.ry))), sy = Math.abs(Math.sin(rad(state.ry)));
+  const halfW = (P / 2) * cy + (D / 2) * sy;
+  const halfH = (P / 2) * (cx + sx * sy) + (D / 2) * sx * cy;
+  const PERSPECTIVE = 1600;
+  const mag = PERSPECTIVE / Math.max(PERSPECTIVE - D / 2, 200);
+  // Tags hang off one side only, so their allowance is added once.
+  const w = (2 * halfW + (tagW || 0) * cy) * mag;
+  const h = 2 * halfH * mag;
+  const box = figBox();
+  return clamp(Math.min(box.w / w, box.h / h) * 0.97, 0.25, 1);
+}
+
+function renderExplode() {
+  const on = state.exploded && state.mode === "cubes";
+  el.explodeBtn.setAttribute("aria-pressed", String(on));
+  el.explodeBtn.textContent = on ? "Rebuild cube" : "Explode layers";
+  el.cubeSolid.hidden = on;
+  el.cubeLayers.hidden = !on;
+  positionLayers();
+}
+
+function renderNotation() {
+  const c = cfg();
+  const forward = state.direction === "right";
+  el.body.dataset.dir = state.direction;
+  el.dirRight.setAttribute("aria-pressed", String(forward));
+  el.dirLeft.setAttribute("aria-pressed", String(!forward));
+  el.opLabel.textContent = forward ? c.opForward : c.opBackward;
+
+  if (forward) {
+    el.notation.innerHTML = state.n + "<sup>" + c.exponent + "</sup>";
+    el.eqLine.innerHTML =
+      "<b>" + state.n + "</b><sup>" + c.exponent + "</sup> = <b>" + total() + "</b>";
+  } else {
+    const idx = c.radicalIndex
+      ? '<span class="idx">' + c.radicalIndex + "</span>" : "";
+    el.notation.innerHTML =
+      '<span class="radical">' + idx + RADICAL_SVG +
+      '<span class="rad">' + total() + "</span></span>";
+    el.eqLine.innerHTML =
+      (c.radicalIndex ? "cube root" : "square root") +
+      " of <b>" + total() + "</b> = <b>" + state.n + "</b>";
+  }
+}
+
+function renderCounter(animate) {
+  const c = cfg();
+  const N = total();
+  el.totalValue.textContent = String(N);
+  el.totalEq.textContent = state.n + " × " + state.n +
+    (c.dim === 3 ? " × " + state.n : "") + " = " + N;
+  el.totalSub.textContent = c.dim === 3
+    ? state.n + " layers × " + (state.n * state.n) + " = " + N + " " + c.unitNamePlural
+    : c.unitNamePlural + " in all";
+  if (animate) {
+    el.totalValue.classList.remove("tick");
+    void el.totalValue.offsetWidth;   // restart the animation
+    el.totalValue.classList.add("tick");
+  }
+  el.liveSummary.textContent =
+    "Side length " + state.n + ". " + N + " " + c.unitNamePlural + ". " +
+    (state.direction === "right"
+      ? state.n + " to the power of " + c.exponent + " equals " + N
+      : "The " + (c.dim === 3 ? "cube" : "square") + " root of " + N + " is " + state.n);
+}
+
+/** Which side is being treated as the given, and which is derived. */
+function renderRoles() {
+  const forward = state.direction === "right";
+  el.leftRole.textContent = forward ? "Start with" : "Answer";
+  el.rightRole.textContent = forward ? "Answer" : "Start with";
+  el.leftRole.classList.toggle("is-input", forward);
+  el.rightRole.classList.toggle("is-input", !forward);
+
+  // Highlight order follows the arrow: the given pulses first.
+  const givenEl = forward ? el.sideValue : el.totalValue;
+  const derivedEl = forward ? el.totalValue : el.sideValue;
+  pulse(givenEl, 0);
+  pulse(derivedEl, 180);
+}
+function pulse(node, delay) {
+  setTimeout(() => {
+    node.classList.remove("pulse");
+    void node.offsetWidth;
+    node.classList.add("pulse");
+  }, delay);
+}
+
+function applyRotation() {
+  el.cubeStage.style.setProperty("--rx", state.rx + "deg");
+  el.cubeStage.style.setProperty("--ry", state.ry + "deg");
+  updateFit();   // a new angle projects to a different size
+}
+
+/* ============================================================================
+ * 5. EVENTS
+ * ==========================================================================*/
+el.sideSlider.addEventListener("input", (e) => {
+  setState({ n: parseInt(e.target.value, 10) });
+});
+
+el.modeSquares.addEventListener("click", () => switchMode("squares"));
+el.modeCubes.addEventListener("click", () => switchMode("cubes"));
+
+function switchMode(mode) {
+  if (state.mode === mode) return;
+  const c = CONFIG[mode];
+  // Keep the current side length where it is legal in the new mode.
+  const n = Math.max(c.min, Math.min(c.max, state.n));
+  setState({ mode, n, exploded: false });
+}
+
+el.dirRight.addEventListener("click", () => setState({ direction: "right" }));
+el.dirLeft.addEventListener("click",  () => setState({ direction: "left" }));
+
+el.explodeBtn.addEventListener("click", () => setState({ exploded: !state.exploded }));
+el.resetViewBtn.addEventListener("click", () => {
+  el.cubeStage.classList.remove("nosnap");
+  setState({ rx: SEED_RX, ry: SEED_RY });
+});
+
+/* Drag to rotate. Pointer Events, so touch works when the mobile layout is
+   finished. Pitch is clamped so the cube never lands face-on or upside down. */
+let drag = null;
+el.cubeFig.addEventListener("pointerdown", (e) => {
+  drag = { id: e.pointerId, x: e.clientX, y: e.clientY, rx: state.rx, ry: state.ry };
+  el.cubeFig.setPointerCapture(e.pointerId);
+  el.cubeFig.classList.add("dragging");
+  el.cubeStage.classList.add("nosnap");
+});
+el.cubeFig.addEventListener("pointermove", (e) => {
+  if (!drag || e.pointerId !== drag.id) return;
+  const rx = clamp(drag.rx - (e.clientY - drag.y) * 0.4, -80, 80);
+  const ry = drag.ry + (e.clientX - drag.x) * 0.4;
+  setState({ rx, ry });
+});
+function endDrag(e) {
+  if (!drag || (e && e.pointerId !== drag.id)) return;
+  drag = null;
+  el.cubeFig.classList.remove("dragging");
+  el.cubeStage.classList.remove("nosnap");
+}
+el.cubeFig.addEventListener("pointerup", endDrag);
+el.cubeFig.addEventListener("pointercancel", endDrag);
+
+/* Keyboard shortcuts that do not fight the slider's own arrow keys. */
+document.addEventListener("keydown", (e) => {
+  if (e.target === el.sideSlider || e.metaKey || e.ctrlKey || e.altKey) return;
+  const k = e.key.toLowerCase();
+  if (k === "s") switchMode("squares");
+  else if (k === "c") switchMode("cubes");
+  else if (k === "e" && state.mode === "cubes") setState({ exploded: !state.exploded });
+  else if (k === "r") setState({ rx: SEED_RX, ry: SEED_RY });
+  else if (k === "d") setState({ direction: state.direction === "right" ? "left" : "right" });
+});
+
+/* ============================================================================
+ * 6. LEVELS — registry so later levels are an added entry, not a refactor.
+ *    Shape: { id, title, setup(state), controls: [ids to show], validate(s) }
+ *    Only level 1 exists today; ?level=1 selects it.
+ * ==========================================================================*/
+const LEVELS = {
+  1: {
+    id: 1,
+    title: "Level 1 · Explore",
+    setup() { /* base level: everything is driven by the slider */ },
+    validate() { return true; }
+  }
+  // 2: build-the-square/cube, 3: enter the notation, 4: imperfect roots ...
+};
+
+function boot() {
+  const requested = parseInt(new URLSearchParams(location.search).get("level") || "1", 10);
+  const level = LEVELS[requested] ? requested : 1;
+  state.level = level;
+  el.levelTag.textContent = LEVELS[level].title;
+  LEVELS[level].setup(state);
+
+  renderChrome();
+  renderSlider();
+  renderRow();
+  renderFigure(null);
+  renderExplode();
+  renderNotation();
+  renderCounter(false);
+  renderRoles();
+  applyRotation();
+}
+boot();
+
+/* Figures are sized from measured space, so a resize needs a re-fit. */
+let resizeTimer = null;
+window.addEventListener("resize", () => {
+  clearTimeout(resizeTimer);
+  resizeTimer = setTimeout(() => {
+    invalidateBox();
+    renderRow();
+    renderFigure(null);
+    if (state.mode === "cubes") positionLayers();
+  }, 120);
+});
+
+/* Exposed for the verification harness and for later levels. */
+window.SCE = { state, setState, CONFIG, LEVELS, total, switchMode };
+</script>
+</body>
+</html>
